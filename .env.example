# ==========================================
# MAIL SERVER SMTP CONFIGURATION
# ==========================================
# SMTP Host (e.g. smtp.gmail.com, smtp.mailtrap.io, smtp.resend.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP Secure (false for port 587, true for port 465)
SMTP_SECURE=false

# SMTP User (Your Gmail address or SMTP username)
SMTP_USER=nguyenductoan538@gmail.com

# SMTP Password / App Password (For Gmail: Use App Password generated from Google Account)
SMTP_PASS=your-smtp-app-password-here

# Sender & Recipient Configuration
MAIL_FROM="Portfolio Contact Form <nguyenductoan538@gmail.com>"
MAIL_TO=nguyenductoan538@gmail.com
